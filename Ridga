#!/bin/bash
# Ridga by TimoNiki (C) TimoNiki

if [ "$1" = "--update" ]; then
    sleep 1.5
    echo "🔄 Starting ridga update..."
    sleep 3
    echo "downloading installer..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/TimoNiki/Ridga-cli/refs/heads/main/installer.sh)"
    echo "New Version of Ridga-cli installed!"
    exit 0
fi

if [ "$1" = "--version" ]; then
    echo Ridga V1.0.2
    echo C TimoNiki
    exit 0
fi

if [ "$1" = "--restart" ]; then
        /usr/local/bin/ridga
        exit 0
fi

if [ "$1" = "--set ridga by TimoNiki" ]; then
        echo "Hi!"
fi

if [ "$1" = "verify" ]; then
    if [ -z "$2" ]; then
        echo "ERROR."
        exit 1
    fi
    /usr/local/bin/ridga_verify "$2"
    exit 0
fi

if [ -z "$2" ] || [ "$1" != "install" ]; then
    echo "ERROR"
    echo "Ridga V1.0.2"
    echo "copyright (C) 2026 TimoNiki"
    exit 1
fi

APP_NAME="$2"
JSON_URL="https://raw.githubusercontent.com/TimoNiki/Ridga-cli/refs/heads/main/apps.json"
USE_V1_LIST=false

if [ "$3" = "-1vers" ] || [ "$3" = "--1vers" ]; then
    echo "🔄 Ver1 flag founded. Searching in ver1 data-base"
    USE_V1_LIST=true
fi

echo "⏳ loading app lists"
JSON_DATA=$(curl -fsSL "$JSON_URL")

if [ -z "$JSON_DATA" ]; then
    echo "❌ ERROR NO APP IN DATA BASE OR NO INTERNET CONNECTION"
    exit 1
fi

echo "LOADING DOWNLOAD SCRIPTS FOR '$APP_NAME' In data-base"

if [ "$USE_V1_LIST" = true ]; then
    DIRECT_URL=$(echo "$JSON_DATA" | sed -n '/"direct_apps_v1"/,$p' | grep -i "\"$APP_NAME\":" | head -n 1 | cut -d'"' -f4)
else
    BREW_CASK=$(echo "$JSON_DATA" | sed -n '/"brew_apps"/,/"direct_apps"/p' | grep -i "\"$APP_NAME\":" | head -n 1 | cut -d'"' -f4)
    if [ -n "$BREW_CASK" ]; then
        echo "📦 APP FOUNDED IN BREW LIST. $BREW_CASK..."
        brew install --cask "$BREW_CASK"
        exit 0
    fi
    DIRECT_URL=$(echo "$JSON_DATA" | sed -n '/"direct_apps"/,/"direct_apps_v1"/p' | grep -i "\"$APP_NAME\":" | head -n 1 | cut -d'"' -f4)
fi

if [ -n "$DIRECT_URL" ]; then
    echo "🌐 URL FOUNDED"
    EXT="${DIRECT_URL##*.}"
    if [[ "$EXT" == *"?"* ]] || [ -z "$EXT" ]; then 
        EXT="dmg"
    fi
    
    if [ "$EXT" = "zip" ]; then
        DOWNLOAD_PATH="$HOME/Downloads/${APP_NAME}.zip"
        echo "⏳ Downloading ZIP to downloads: $DOWNLOAD_PATH"
        curl -L -fsSL "$DIRECT_URL" -o "$DOWNLOAD_PATH"
        echo "🎉 Successfully downloaded! "
        exit 0
    fi
    
    TMP_FILE="/tmp/ridga_installer.$EXT"
    echo "⏳ File downloading: $DIRECT_URL"
    curl -L -fsSL "$DIRECT_URL" -o "$TMP_FILE"
    
    if [ "$EXT" = "pkg" ]; then
        echo "⚙️ Starting pkg installer...."
        sudo installer -pkg "$TMP_FILE" -target /
        rm -f "$TMP_FILE"
    elif [ "$EXT" = "jar" ]; then
        echo "☕ founded Java-file (.jar)..."
        if ! command -v java &> /dev/null; then
            echo "⚠️ WARNING: No Java found in the OS; the downloaded .jar file cannot run without Java."
        fi
        sudo mv "$TMP_FILE" "/Applications/${APP_NAME}.jar"
        sudo chmod +x "/Applications/${APP_NAME}.jar"
        echo "💡 Tip: You can launch the program using a command in the terminal: java -jar /Applications/${APP_NAME}.jar"
    else
        echo "💿 Mounting DMG image..."
        MOUNT_DIR=$(hdiutil attach -nobrowse "$TMP_FILE" | grep -o '/Volumes/.*' | head -n 1)
        if [ -n "$MOUNT_DIR" ]; then
            echo "📂 Copying app to /Applications..."
            sudo cp -R "$MOUNT_DIR"/*.app /Applications/ 2>/dev/null
            echo "⏏️ DMG"
            hdiutil detach "$MOUNT_DIR"
        else
            echo "❌ ERROR: Failed to mount the downloaded DMG file."
            rm -f "$TMP_FILE"
            exit 1
        fi
        rm -f "$TMP_FILE"
    fi
    
    echo "🎉 Программа $APP_NAME успешно установлена!"
    exit 0
fi

echo "❌ Ошибка: Программа '$APP_NAME' не найдена в соответствующем списке apps.json на GitHub."
exit 1
